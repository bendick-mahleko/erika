# pgBackRest settings for the LOCAL drill (DEV-ONLY values). Production: the same keys in
# /opt/erika/pgbackrest.env on the database server, from SOPS (infra/production/README).
PGBACKREST_STANZA=erika
PGBACKREST_PG1_PATH=/var/lib/postgresql/data
PGBACKREST_REPO1_TYPE=s3
PGBACKREST_REPO1_PATH=/erika
PGBACKREST_REPO1_S3_BUCKET=erika-pgbackrest
PGBACKREST_REPO1_S3_ENDPOINT=s3
PGBACKREST_REPO1_STORAGE_PORT=8333
PGBACKREST_REPO1_S3_REGION=eu-central-1
PGBACKREST_REPO1_S3_KEY=drill
PGBACKREST_REPO1_S3_KEY_SECRET=drill-secret
PGBACKREST_REPO1_S3_URI_STYLE=path
# Self-signed certificate in the drill only; production verifies TLS.
PGBACKREST_REPO1_STORAGE_VERIFY_TLS=n
PGBACKREST_REPO1_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO1_CIPHER_PASS=drill-cipher-pass-dev-only
PGBACKREST_REPO1_RETENTION_FULL_TYPE=time
PGBACKREST_REPO1_RETENTION_FULL=35
PGBACKREST_COMPRESS_TYPE=zst
PGBACKREST_ARCHIVE_ASYNC=y
PGBACKREST_SPOOL_PATH=/var/spool/pgbackrest
PGBACKREST_ARCHIVE_PUSH_QUEUE_MAX=4GiB
PGBACKREST_PROCESS_MAX=2
PGBACKREST_START_FAST=y
PGBACKREST_LOG_LEVEL_CONSOLE=warn
PGBACKREST_LOG_LEVEL_FILE=off
