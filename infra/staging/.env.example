# Staging configuration template. Copy to /opt/erika/.env on the server.
# Keep the real file encrypted in the repo as infra/staging/.env.sops (SOPS + age);
# never commit it in plain text.

ERIKA_DOMAIN=staging.erika-app.de
# Lowercase, as on ghcr.io
ERIKA_IMAGE_REPO=<github-owner>/<repo>

# Basic auth for the whole staging site (hash: `caddy hash-password`)
STAGING_USER=erika
STAGING_PASSWORD_HASH=

# PostgreSQL
POSTGRES_SUPERUSER_PASSWORD=
ERIKA_DB_OWNER_PASSWORD=
ERIKA_DB_APP_PASSWORD=

# Object storage (separate staging bucket, created with Object Lock if supported)
ERIKA_S3_ENDPOINT=https://fsn1.your-objectstorage.com
ERIKA_S3_REGION=fsn1
ERIKA_S3_BUCKET=erika-staging-originals
ERIKA_S3_ACCESS_KEY=
ERIKA_S3_SECRET_KEY=
ERIKA_S3_PATH_STYLE=false
# Backup bucket (second location in production): audit chain head hashes (NF-10)
ERIKA_BACKUP_BUCKET=erika-staging-backups
# Originals bucket must be created with Object Lock (ADR 0013, 0022). The app key needs
# read/write/list and Put/GetObjectRetention, but no delete permission. NONE only if the
# provider has no Object Lock.
ERIKA_ARCHIVE_OBJECT_LOCK=COMPLIANCE
# Quarantine for uploads before the virus scan (ADR 0023): no Object Lock, lifecycle rule
# "expire after 1 day", CORS rule allowing PUT from https://$ERIKA_DOMAIN. The app key
# needs read/write/list/delete on this bucket only.
ERIKA_S3_UPLOADS_BUCKET=erika-staging-uploads
# PDF view copies and decoded attachments (ADR 0025): no Object Lock; the app key needs
# read/write/list. Can be emptied at any time; everything is rebuilt from the originals.
ERIKA_S3_DERIVED_BUCKET=erika-staging-derived

# Email intake (IN-01, ADR 0024): addresses are <token>@$ERIKA_INTAKE_MAIL_DOMAIN.
# DNS: MX for the domain → $ERIKA_MAIL_HOSTNAME; see docs/ops/intake.md.
ERIKA_INTAKE_MAIL_DOMAIN=in.staging.erika-app.de
ERIKA_MAIL_HOSTNAME=mx.staging.erika-app.de
# Shared secret between the mail container and the API (`openssl rand -hex 32`).
ERIKA_INTAKE_MAIL_SECRET=
# Optional TLS certificate for STARTTLS (paths inside the mail container).
ERIKA_MAIL_TLS_CERT=
ERIKA_MAIL_TLS_KEY=

# Identity: AES-256 key for TOTP secrets at rest (`openssl rand -base64 32`). Losing it
# means every user must set up 2FA again; keep it in SOPS together with this file.
ERIKA_TOTP_ENCRYPTION_KEY=

# Outgoing mail (verification, lockout and new-device notices)
ERIKA_MAIL_FROM=ERIKA Staging <no-reply@staging.erika-app.de>
ERIKA_SMTP_HOST=
ERIKA_SMTP_PORT=587
ERIKA_SMTP_USER=
ERIKA_SMTP_PASSWORD=

# GlitchTip (optional)
ERIKA_SENTRY_DSN=

# PostgreSQL image with pgBackRest (ghcr.io/<repo>/postgres), pinned separately from the
# app release because a new tag restarts the database. Backups: pgbackrest.env next to
# this file (template infra/production/db/pgbackrest.env.example, staging bucket).
# Switching from the former postgres:16-alpine image: run REINDEX DATABASE erika once
# (Alpine and Debian sort text differently), or start staging with a fresh volume.
ERIKA_POSTGRES_IMAGE_TAG=16.15-<short commit sha, see .github/workflows/postgres-image.yml>
ERIKA_WAL_ARCHIVE=on

# Closed beta (ADR 0030): invitation links (`openssl rand -hex 32`), feedback address.
ERIKA_SIGNUP_MODE=INVITE_ONLY
ERIKA_INVITE_SECRET=
ERIKA_FEEDBACK_TO=

# Invoice creator (ADR 0031): delivery webhook of the mail provider (`openssl rand -hex 32`); empty = off.
ERIKA_MAIL_WEBHOOK_SECRET=
