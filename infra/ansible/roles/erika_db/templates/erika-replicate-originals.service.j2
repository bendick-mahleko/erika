# Managed by Ansible (role erika_db).
[Unit]
Description=Nightly copy of originals and audit heads to the second location
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=ERIKA_COMPOSE_DIR=/opt/erika
Environment=ERIKA_TEXTFILE_DIR=/var/lib/node_exporter/textfile
Environment=ERIKA_DRILL_REPORT_DIR=/var/log/erika
ExecStart=/opt/erika/backup/replicate-originals.sh
TimeoutStartSec=8h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
