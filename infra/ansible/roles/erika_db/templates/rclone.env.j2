# Managed by Ansible (role erika_db). Template: infra/production/db/rclone.env.example.
RCLONE_CONFIG_PRIMARY_TYPE=s3
RCLONE_CONFIG_PRIMARY_PROVIDER=Other
RCLONE_CONFIG_PRIMARY_ENDPOINT=https://{{ erika_s3_primary_location }}.your-objectstorage.com
RCLONE_CONFIG_PRIMARY_REGION={{ erika_s3_primary_location }}
RCLONE_CONFIG_PRIMARY_ACCESS_KEY_ID={{ erika_s3_primary_access_key }}
RCLONE_CONFIG_PRIMARY_SECRET_ACCESS_KEY={{ erika_s3_primary_secret_key }}
RCLONE_CONFIG_REPLICA_TYPE=s3
RCLONE_CONFIG_REPLICA_PROVIDER=Other
RCLONE_CONFIG_REPLICA_ENDPOINT=https://{{ erika_s3_backup_location }}.your-objectstorage.com
RCLONE_CONFIG_REPLICA_REGION={{ erika_s3_backup_location }}
RCLONE_CONFIG_REPLICA_ACCESS_KEY_ID={{ erika_s3_backup_access_key }}
RCLONE_CONFIG_REPLICA_SECRET_ACCESS_KEY={{ erika_s3_backup_secret_key }}
ERIKA_S3_BUCKET={{ erika_bucket_prefix }}-originals
ERIKA_BACKUP_BUCKET={{ erika_bucket_prefix }}-audit-heads
ERIKA_REPLICA_ORIGINALS_BUCKET={{ erika_bucket_prefix }}-originals-replica
ERIKA_REPLICA_AUDIT_BUCKET={{ erika_bucket_prefix }}-audit-heads-replica
