# Managed by Ansible (role erika_db). Template: infra/production/db/pgbackrest.env.example.
PGBACKREST_STANZA=erika
PGBACKREST_PG1_PATH=/var/lib/postgresql/data
PGBACKREST_REPO1_TYPE=s3
PGBACKREST_REPO1_PATH=/{{ erika_bucket_prefix }}
PGBACKREST_REPO1_S3_BUCKET={{ erika_bucket_prefix }}-pgbackrest
PGBACKREST_REPO1_S3_ENDPOINT={{ erika_s3_backup_location }}.your-objectstorage.com
PGBACKREST_REPO1_S3_REGION={{ erika_s3_backup_location }}
PGBACKREST_REPO1_S3_URI_STYLE=host
PGBACKREST_REPO1_S3_KEY={{ erika_s3_backup_access_key }}
PGBACKREST_REPO1_S3_KEY_SECRET={{ erika_s3_backup_secret_key }}
PGBACKREST_REPO1_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO1_CIPHER_PASS={{ erika_pgbackrest_cipher_pass }}
PGBACKREST_REPO1_RETENTION_FULL_TYPE=time
PGBACKREST_REPO1_RETENTION_FULL=35
PGBACKREST_COMPRESS_TYPE=zst
PGBACKREST_ARCHIVE_ASYNC=y
PGBACKREST_SPOOL_PATH=/var/spool/pgbackrest
PGBACKREST_ARCHIVE_PUSH_QUEUE_MAX=8GiB
PGBACKREST_PROCESS_MAX=2
PGBACKREST_START_FAST=y
PGBACKREST_LOG_LEVEL_CONSOLE=warn
PGBACKREST_LOG_LEVEL_FILE=off
