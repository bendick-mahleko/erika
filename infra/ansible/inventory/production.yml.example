# Generated by Terraform:  terraform -chdir=../terraform output -raw ansible_inventory > inventory/production.yml
all:
  vars:
    ansible_user: erika
    erika_domain: erika-app.de
    erika_private_ip: { app: 10.0.1.10, db: 10.0.1.20, ops: 10.0.1.30 }
  children:
    app:
      hosts:
        erika-app: { ansible_host: 203.0.113.20, private_ip: 10.0.1.10 }
    ops:
      hosts:
        erika-ops: { ansible_host: 203.0.113.30, private_ip: 10.0.1.30 }
    db:
      hosts:
        erika-db:
          ansible_host: 10.0.1.20
          private_ip: 10.0.1.20
          ansible_ssh_common_args: "-o ProxyJump=erika@203.0.113.20"
          pgdata_device: /dev/disk/by-id/scsi-0HC_Volume_100000000
