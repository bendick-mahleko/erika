# terraform init -backend-config=backend.hcl
# State bucket in the backup project (create it once in the console, with versioning).
bucket                      = "erika-prod-tfstate"
key                         = "production/terraform.tfstate"
region                      = "nbg1"
endpoints                   = { s3 = "https://nbg1.your-objectstorage.com" }
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
use_path_style              = false
# Credentials: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY of the backup project.
