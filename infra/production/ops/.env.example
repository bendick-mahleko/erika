# Ops server: template for /opt/erika-ops/.env (written by Ansible from SOPS).
ERIKA_DOMAIN=erika-app.de
ERIKA_ACME_EMAIL=ops@erika-app.de
ERIKA_PRIVATE_IP=10.0.1.30
ERIKA_ALERT_MAIL_FROM=ERIKA Monitoring <monitoring@erika-app.de>

GRAFANA_ADMIN_USER=admin
# secrets/grafana_admin_password and secrets/alertmanager/* are files, written by Ansible.

GLITCHTIP_DB_PASSWORD=
# `openssl rand -hex 32`
GLITCHTIP_SECRET_KEY=
# smtp://user:password@host:587 (the EU mail provider, as for the app)
GLITCHTIP_EMAIL_URL=
