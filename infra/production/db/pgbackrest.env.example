# pgBackRest settings (ADR 0028): template for /opt/erika/pgbackrest.env on the database
# server (and on staging, with the staging bucket). Ansible writes the real file from SOPS.
#
# Repository: Hetzner Object Storage in nbg1 (second location), in the separate backup
# project whose keys exist only on the database server. Encrypted client-side with
# AES-256 (repo1-cipher-pass): the provider never sees plain data.
# LOSING THE CIPHER PASS MAKES EVERY BACKUP UNREADABLE. Keep it in SOPS and offline.
PGBACKREST_STANZA=erika
PGBACKREST_PG1_PATH=/var/lib/postgresql/data
PGBACKREST_REPO1_TYPE=s3
PGBACKREST_REPO1_PATH=/erika-prod
PGBACKREST_REPO1_S3_BUCKET=erika-prod-pgbackrest
PGBACKREST_REPO1_S3_ENDPOINT=nbg1.your-objectstorage.com
PGBACKREST_REPO1_S3_REGION=nbg1
PGBACKREST_REPO1_S3_URI_STYLE=host
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
PGBACKREST_REPO1_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO1_CIPHER_PASS=
# NF-05 / design: nightly full backups, kept 35 days (with the WAL needed to restore them).
PGBACKREST_REPO1_RETENTION_FULL_TYPE=time
PGBACKREST_REPO1_RETENTION_FULL=35
PGBACKREST_COMPRESS_TYPE=zst
PGBACKREST_ARCHIVE_ASYNC=y
PGBACKREST_SPOOL_PATH=/var/spool/pgbackrest
# If the repository is unreachable for long, drop WAL instead of filling the disk (alert fires).
PGBACKREST_ARCHIVE_PUSH_QUEUE_MAX=8GiB
PGBACKREST_PROCESS_MAX=2
PGBACKREST_START_FAST=y
PGBACKREST_LOG_LEVEL_CONSOLE=warn
PGBACKREST_LOG_LEVEL_FILE=off
