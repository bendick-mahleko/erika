# Production database server: template for /opt/erika/.env (written by Ansible from SOPS).
ERIKA_IMAGE_REPO=<github-owner>/<repo>
# PostgreSQL + pgBackRest image (.github/workflows/postgres-image.yml); change deliberately.
ERIKA_POSTGRES_IMAGE_TAG=16.15-<short sha>
ERIKA_PRIVATE_IP=10.0.1.20
ERIKA_OPS_HOST=10.0.1.30

POSTGRES_SUPERUSER_PASSWORD=
ERIKA_DB_OWNER_PASSWORD=
ERIKA_DB_APP_PASSWORD=
ERIKA_DB_MONITOR_PASSWORD=
