# Nightly replication of originals and audit heads (infra/backup/replicate-originals.sh,
# ADR 0028): template for /opt/erika/rclone.env on the database server, written by Ansible.
#   primary  = the app's project, fsn1 (read)
#   replica  = the backup project, nbg1 (write); buckets with Object Lock default retention
RCLONE_CONFIG_PRIMARY_TYPE=s3
RCLONE_CONFIG_PRIMARY_PROVIDER=Other
RCLONE_CONFIG_PRIMARY_ENDPOINT=https://fsn1.your-objectstorage.com
RCLONE_CONFIG_PRIMARY_REGION=fsn1
RCLONE_CONFIG_PRIMARY_ACCESS_KEY_ID=
RCLONE_CONFIG_PRIMARY_SECRET_ACCESS_KEY=

RCLONE_CONFIG_REPLICA_TYPE=s3
RCLONE_CONFIG_REPLICA_PROVIDER=Other
RCLONE_CONFIG_REPLICA_ENDPOINT=https://nbg1.your-objectstorage.com
RCLONE_CONFIG_REPLICA_REGION=nbg1
RCLONE_CONFIG_REPLICA_ACCESS_KEY_ID=
RCLONE_CONFIG_REPLICA_SECRET_ACCESS_KEY=

ERIKA_S3_BUCKET=erika-prod-originals
ERIKA_BACKUP_BUCKET=erika-prod-audit-heads
ERIKA_REPLICA_ORIGINALS_BUCKET=erika-prod-originals-replica
ERIKA_REPLICA_AUDIT_BUCKET=erika-prod-audit-heads-replica
