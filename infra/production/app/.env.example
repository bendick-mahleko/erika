# Production app server: template for /opt/erika/.env. Ansible writes the real file from
# infra/production/secrets.sops.yaml (SOPS + age); never commit it in plain text.

ERIKA_DOMAIN=erika-app.de
ERIKA_ACME_EMAIL=ops@erika-app.de
ERIKA_IMAGE_REPO=<github-owner>/<repo>
# Set by deploy.sh; only for manual `docker compose` commands.
ERIKA_IMAGE_TAG=

# Private network (ADR 0027)
ERIKA_PRIVATE_IP=10.0.1.10
ERIKA_DB_HOST=10.0.1.20
ERIKA_OPS_HOST=10.0.1.30
# For deploy.sh's WAL check before a release (SSH over the private network).
ERIKA_DB_SSH=erika@10.0.1.20

# PostgreSQL (same passwords as on the database server)
ERIKA_DB_OWNER_PASSWORD=
ERIKA_DB_APP_PASSWORD=

# Object storage, primary location fsn1 (ADR 0013, 0022, 0028)
ERIKA_S3_ENDPOINT=https://fsn1.your-objectstorage.com
ERIKA_S3_REGION=fsn1
ERIKA_S3_ACCESS_KEY=
ERIKA_S3_SECRET_KEY=
ERIKA_S3_BUCKET=erika-prod-originals
ERIKA_S3_UPLOADS_BUCKET=erika-prod-uploads
ERIKA_S3_DERIVED_BUCKET=erika-prod-derived
ERIKA_S3_EXPORTS_BUCKET=erika-prod-exports
# Audit chain heads (ADR 0019); replicated nightly to the second location.
ERIKA_BACKUP_BUCKET=erika-prod-audit-heads

# Identity (`openssl rand -base64 32`); losing it means every user sets up 2FA again.
ERIKA_TOTP_ENCRYPTION_KEY=

# Outgoing mail (EU provider with AVV, NF-01)
ERIKA_MAIL_FROM=ERIKA <no-reply@erika-app.de>
ERIKA_SMTP_HOST=
ERIKA_SMTP_PORT=587
ERIKA_SMTP_USER=
ERIKA_SMTP_PASSWORD=

# Inbound mail (IN-01, ADR 0024)
ERIKA_INTAKE_MAIL_DOMAIN=in.erika-app.de
ERIKA_MAIL_HOSTNAME=mx.erika-app.de
ERIKA_INTAKE_MAIL_SECRET=

# Closed beta (ADR 0030)
ERIKA_SIGNUP_MODE=INVITE_ONLY
ERIKA_INVITE_SECRET=
ERIKA_TERMS_VERSION=beta-2026-12
ERIKA_FEEDBACK_TO=beta@erika-app.de

# Invoice creator (ADR 0031): shared secret of the mail provider's delivery webhook
# (https://$ERIKA_DOMAIN/webhooks/mail, header X-Erika-Webhook-Secret; `openssl rand -hex 32`).
ERIKA_MAIL_WEBHOOK_SECRET=

# GlitchTip DSN of the project "erika-backend" (https://errors.erika-app.de)
ERIKA_SENTRY_DSN=
