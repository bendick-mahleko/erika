<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- App Store export for TestFlight (MARA Stage 9, .github/workflows/mobile-release.yml).
     The team ID is filled in when the Apple developer account exists. -->
<plist version="1.0">
<dict>
  <key>method</key>
  <string>app-store-connect</string>
  <key>destination</key>
  <string>export</string>
  <key>signingStyle</key>
  <string>manual</string>
  <key>teamID</key>
  <string>TEAM_ID_TO_BE_SET</string>
  <key>provisioningProfiles</key>
  <dict>
    <key>de.erika.mara</key>
    <string>MARA App Store</string>
  </dict>
  <key>uploadSymbols</key>
  <true/>
</dict>
</plist>
